# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).

# Safe to expose to the browser - RLS enforces access control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY. Never expose this to the browser or commit it.
# Needed to run scripts/migrate-from-json.ts (one-time legacy import) and
# the two Playwright e2e setup scripts below (scripts/e2e-create-qa-bot.ts,
# scripts/e2e-auth-setup.ts) - both bypass RLS via the Supabase admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Playwright e2e - a dedicated internal-role profile (NOT a real rep's
# account), created once via `npm run e2e:create-qa-bot`. Keeps automated
# test actions clearly separate from real human activity in activities/
# audit trails. Every e2e test runs read-only against loki-crm-prod (the
# real database - there is no separate test environment).
PLAYWRIGHT_TEST_EMAIL=qa-bot@lokicoach.com
