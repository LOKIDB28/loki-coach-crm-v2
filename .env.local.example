# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).

# Safe to expose to the browser - RLS enforces access control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY. Never expose this to the browser or commit it.
# Only needed to run scripts/migrate-from-json.ts (the one-time migration
# script), which bypasses RLS to bulk-import the legacy prototype's data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
