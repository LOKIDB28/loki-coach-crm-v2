# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).

# Safe to expose to the browser - RLS enforces access control.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY. Never expose this to the browser or commit it.
# Needed to run scripts/migrate-from-json.ts (one-time legacy import) and
# the two Playwright e2e setup scripts below (scripts/e2e-create-qa-bot.ts,
# scripts/e2e-auth-setup.ts) - both bypass RLS via the Supabase admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Playwright e2e - a dedicated internal-role profile (NOT a real rep's
# account), created once via `npm run e2e:create-qa-bot`. Keeps automated
# test actions clearly separate from real human activity in activities/
# audit trails. Every e2e test runs read-only against loki-crm-prod (the
# real database - there is no separate test environment).
PLAYWRIGHT_TEST_EMAIL=qa-bot@lokicoach.com

# Sentry error tracking. The DSN isn't a secret (it's meant to be public -
# same value client and server side), but it and the other three below are
# only actually set in Vercel (Production + Preview), not in local
# .env.local - Sentry.init() is disabled outside NODE_ENV=production anyway,
# see src/instrumentation-client.ts / sentry.server.config.ts.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Only needed at build time, to upload source maps - see next.config.js.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
